{
  "name": "case-prompt",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "postCreateCommand": "cd api && npm ci",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "API Nest", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "node"
}
