generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMINISTRATOR
}

model User {
  // Text id: the login step will put it in the token's `sub` claim, which is a string.
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())
}
