PORT=3000

# The front's address, allowed by CORS.
FRONT_URL=http://localhost:5173

# PostgreSQL. With Docker: postgresql://admin:admin@localhost:5432/caseprompt
# Without Docker: `npx prisma dev` starts a local Postgres and prints its URL.
DATABASE_URL=postgresql://admin:admin@localhost:5432/caseprompt

# Signs the login tokens. At least 32 bytes, one per environment, never on GitHub.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
